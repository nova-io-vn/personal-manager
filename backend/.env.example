DATABASE_URL=sqlite:///./data/personal.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Neon pooled URL for cloud sync traffic. Keep local DATABASE_URL on SQLite.
CLOUD_DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Use the direct/unpooled Neon URL for Alembic migrations.
# JWT_SECRET_KEY must be a random secret of at least 32 bytes and must not be committed.
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Packaged desktop builds set PERSONAL_MANAGER_DATA_DIR to Electron userData.
