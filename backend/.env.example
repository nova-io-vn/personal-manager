# Application traffic: Neon pooled PostgreSQL URL.
DATABASE_URL=postgresql://user:password@host-pooler/db?sslmode=require
# Schema migrations: Neon direct/unpooled PostgreSQL URL.
ALEMBIC_DATABASE_URL=postgresql://user:password@host/db?sslmode=require
CORS_ORIGINS=https://personal.nova.io.vn,capacitor://localhost,http://localhost
PUBLIC_BASE_URL=https://personal.nova.io.vn
# Render's render_start.py sets PM_PRODUCTION=1 automatically.
